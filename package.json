{
  "name": "core",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "fetch": "tsx pipeline/fetch/all.ts",
    "cards": "tsx pipeline/build.ts",
    "pipeline": "npm run fetch && npm run cards",
    "seed": "tsx pipeline/fetch/all.ts --seed && tsx pipeline/build.ts",
    "enrich": "tsx pipeline/enrich.ts",
    "sample": "tsx pipeline/sample.ts",
    "icons": "node scripts/icons.mjs",
    "verify": "tsx pipeline/verify.ts",
    "e2e": "node tests/e2e/video.mjs"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "fake-indexeddb": "^6.2.6",
    "playwright": "1.56.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  }
}
